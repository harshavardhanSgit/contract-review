generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  REVIEWER
  VIEWER
}

model Organisation {
  id        String   @id @default(uuid())
  name      String
  createdAt DateTime @default(now())

  users     User[]
  contracts Contract[]
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  role         Role     @default(VIEWER)
  createdAt    DateTime @default(now())

  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id])

  refreshTokens RefreshToken[]
  contracts     Contract[]

  @@index([organisationId])
}

// One row per login. The token itself lives only in the user's cookie;
// we keep a SHA-256 hash of it, so a database leak doesn't hand out live tokens.
// One status at a time, like a parcel tracker. Only these 4 values are allowed.
enum ContractStage {
  INTAKE
  AI_REVIEW
  HUMAN_REVIEW
  APPROVED
}

model Contract {
  id        String        @id @default(uuid())
  title     String
  stage     ContractStage @default(INTAKE)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id])

  uploadedById String
  uploadedBy   User   @relation(fields: [uploadedById], references: [id])

  // The most common query: "my organisation's contracts, newest first".
  @@index([organisationId, createdAt])
}

model RefreshToken {
  id        String    @id @default(uuid())
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}
