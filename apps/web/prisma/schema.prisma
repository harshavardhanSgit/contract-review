generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  REVIEWER
  VIEWER
}

model Organisation {
  id        String   @id @default(uuid())
  name      String
  createdAt DateTime @default(now())

  users User[]
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  role         Role     @default(VIEWER)
  createdAt    DateTime @default(now())

  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id])

  refreshTokens RefreshToken[]

  @@index([organisationId])
}

// One row per login. The token itself lives only in the user's cookie;
// we keep a SHA-256 hash of it, so a database leak doesn't hand out live tokens.
model RefreshToken {
  id        String    @id @default(uuid())
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}
